     ]
    },
    {
     "id": "reservoir",
     "statement": "$N$ 개 spin 의 reservoir 가 있어 물리적 상호작용 개수의 평균이 $\\rho_N$, 장은 통상의 것, 섭동 개수의 평균이 $c_\\nu s_N$ 이고 아래 항등식이 성립한다.",
     "lines": [
      45,
      50
     ]
    },
    {
     "id": "reservoir_mean",
     "label": "cavity:reservoir-mean",
     "statement": "$\\rho_N=\\alpha(N+1)\\bigl(\\frac N{N+1}\\bigr)^p$.",
     "lines": [
      47,
      49
     ]
    },
    {
     "id": "identity",
     "label": "cavity:identity",
     "statement": "$\\Delta_N^{L,\\mathbf u}=\\log2+\\mathbb E\\log Y_{0,\\rm s}-\\mathbb E\\log Y_{0,\\rm b}+o_N(1)$.",
     "lines": [
      51,
      53
     ]
    },
    {
     "id": "identity_error_uniform",
     "statement": "오차는 $L,\\mathbf u$ 에 대해 균등하다.",
     "lines": [
      55,
      55
     ]
    },
    {
     "id": "insertion_setting",
     "statement": "삽입 재귀는 tilted reservoir kernel 과 독립인 새 root disorder 를 쓰고, 끝 삽입은 아래 $A_{\\rm s}$, $A_{\\rm b}$ 이다.",
     "lines": [
      55,
      57
     ]
    },
    {
     "id": "site_insertion",
     "label": "cavity:site-insertion",
     "statement": "$A_{\\rm s}(\\sigma)=\\frac12\\sum_{\\varepsilon=\\pm1}\\exp\\bigl(h\\varepsilon+\\sum_{j=1}^{K_{\\rm s}}\\theta_j(\\sigma_{i_{1,j}},\\ldots,\\sigma_{i_{p-1,j}},\\varepsilon)\\bigr)$.",
     "lines": [
      58,
      62
     ]
    },
    {
     "id": "bond_insertion",
     "label": "cavity:bond-insertion",
     "statement": "$A_{\\rm b}(\\sigma)=\\exp\\bigl(\\sum_{j=1}^{K_{\\rm b}}\\theta_j(\\sigma_{i_{1,j}},\\ldots,\\sigma_{i_{p,j}})\\bigr)$.",
     "lines": [
      63,
      65
     ]
    },
    {
     "id": "insertion_counts",
     "statement": "$K_{\\rm s}\\sim\\mathrm{Pois}(\\alpha p)$, $K_{\\rm b}\\sim\\mathrm{Pois}(\\alpha(p-1))$ 이고 표시된 모든 지표는 $[N]$ 의 독립 균등 지표이다.",
     "lines": [
      67,
