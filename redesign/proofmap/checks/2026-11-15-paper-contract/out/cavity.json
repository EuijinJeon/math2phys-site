 "symbols_new": [
  {
   "id": "perturbation_factors",
   "tex": "$\\psi_\\nu,\\ c_\\nu,\\ s_N,\\ \\mathbf u$",
   "defined_at": "cavity.tex 20–27",
   "text": "$c_\\nu>0$, $\\sum c_\\nu=1$, $s_N=N^{3/4}$ 로 두고, 평균 $c_\\nu s_N$ 인 독립 Poisson 개수, $[N]$ 의 독립 균등 site 의 단일 site factor $\\psi_\\nu$ (각자의 보조변수를 위계를 따라 곱 사전으로 뽑음) 를 spin weight 에 더한다. $1/2\\le\\psi_\\nu\\le3/2$ (식 cavity:factor-bounds). 전체 개수는 $\\mathrm{Pois}(s_N)$."
  },
  {
   "id": "cavity_grid",
   "tex": "$L,\\ r,\\ m_d,\\ \\delta$",
   "defined_at": "cavity.tex 16–19",
   "text": "깊이 $L\\ge2$, $r=L-1$ 단계, 균등 격자 $m_d=d/L$ ($0\\le d\\le L$), $\\delta=1/L$ (식 cavity:grid)."
  },
  {
