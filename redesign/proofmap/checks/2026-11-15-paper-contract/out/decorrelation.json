 "symbols_new": [
  {
   "id": "decor_limit_order",
   "tex": "$\\lim_L\\limsup_N$",
   "defined_at": "decorrelation.tex 4–9",
   "text": "고정된 $L$ 마다 $N$ 극한은 Lemma pert:selection 이 준 크기와 매개변수 선택을 따르고, 그 위에서 Theorem pert:tree-identity 의 항등식이 성립한다. $L$ 이 다르면 수열이 달라도 된다. 논증은 이 항등식과 tree 표본 규칙만 쓰며 상호작용 인수분해는 쓰지 않는다.",
   "note": "pert_selected_limits 를 §7 에서 되풀이한 약속."
  },
  {
   "id": "topology_depth_assignment",
   "tex": "$S,\\ b(S)$",
   "defined_at": "decorrelation.tex 18–21",
   "text": "topology 는 unary vertex 를 지운 labeled leaf 위의 유한 뿌리 tree 이고, 각 branching vertex 에 $\\{0,\\ldots,L-1\\}$ 의 정수 깊이를 주되 모든 가지를 따라 엄격 증가하게 한다. $b(S)$ 는 $S$ 의 branching vertex 개수."
  },
  {
   "id": "eta_regular_assignment",
   "tex": "$\\eta$-regular",
   "defined_at": "decorrelation.tex 21–28",
   "text": "$\\eta>0$ 에 대해 깊이 배정이 $\\eta$-regular 라는 것은 모든 깊이를 $L$ 로 나눈 값이 $(\\eta,1-\\eta)$ 에 있고 서로 다른 branching vertex 의 정규화 깊이가 $\\eta$ 보다 더 떨어져 있다는 것이다. 추가 prefix 깊이 $d$ 가 지정되면 모든 branching 깊이에 대해 같은 제약을 받는다. 한 topology 의 두 사본이 정렬된 깊이를 쓰면 대응 vertex 는 한 깊이 좌표를 공유하고 정규성은 그 서로 다른 좌표에 부과된다.",
   "note": "trees.tex 의 regular_shape (한 tree 의 regular shape) 와는 별개의, 깊이 배정에 대한 정의."
  },
  {
   "id": "spin_product_vector",
   "tex": "$A_S,\\ R_S,\\ x\\cdot y,\\ \\|x\\|_N$",
   "defined_at": "decorrelation.tex 87–92",
   "text": "sampled 복사 $S$ 에 대해 $A_S=(\\prod_{a\\in S}\\sigma_i^a)_{i\\le N}$, $R_S=\\mathbf1\\cdot A_S$, $x\\cdot y=N^{-1}\\sum_{i=1}^Nx_iy_i$, $\\|x\\|_N^2=x\\cdot x$ ($R_S$ 는 tree:multioverlap 의 multioverlap 과 같은 것)."
  },
  {
   "id": "conditional_covariance",
   "tex": "$\\mathscr F_d,\\ \\mu_{d,S},\\ v_N(S,d)$",
   "defined_at": "decorrelation.tex 94–106",
   "text": "$S$ 의 초기 stem 위의 깊이 $d$ (첫 branching 깊이 포함) 에서 $\\mathscr F_d$ 는 root 와 깊이 $d$ 까지의 sampled prefix 가 생성하는 시그마 대수, $\\mu_{d,S}=\\mathbb E[A_S\\mid\\mathscr F_d]$, $v_N(S,d)=\\frac1{N^2}\\mathbb E\\sum_{i,j}\\operatorname{Cov}(A_{S,i},A_{S,j}\\mid\\mathscr F_d)^2$ (기대값은 root 포함). $A_S$ 와 $\\mu_{d,S}$ 의 좌표는 절댓값 $\\le1$, $0\\le v_N\\le1$."
  }
 ],
 "floors_new": [
